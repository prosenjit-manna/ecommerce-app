# Copy to .env (git-ignored). `pnpm keys:generate` fills in the JWT keys.
NODE_ENV=development
PORT=4001
LOG_LEVEL=debug

# Express "trust proxy": number of proxy hops in front of the service (Apollo Router, ALB).
# 0 = use the socket address. Locally behind the router use 1.
TRUST_PROXY=0

DATABASE_URL=postgres://ecommerce:ecommerce@localhost:5432/auth
REDIS_URL=redis://localhost:6379

# JWT (EdDSA / Ed25519). PEM values, newlines escaped as \n.
JWT_ISSUER=ecommerce-auth
JWT_AUDIENCE=ecommerce
JWT_KEY_ID=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_AGE_DAYS=90

# Secret mixed into OTP hashes (min 32 chars).
OTP_PEPPER=change-me-to-a-long-random-string-0123456789
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS=5

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ecommerce <no-reply@ecommerce.local>"

# Optional: path to MaxMind GeoLite2-City.mmdb (free account at maxmind.com). Empty = no geo lookup.
GEOIP_DB_PATH=

# Optional: comma-separated IPs whose requests skip rate limiting (e.g. load tests).
RATE_LIMIT_ALLOWLIST=
