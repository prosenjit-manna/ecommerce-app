{
  "name": "auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && cp src/graphql/schema.graphql dist/graphql/",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --selectProjects unit",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --selectProjects unit --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --selectProjects unit --coverage",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --selectProjects integration --passWithNoTests"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@apollo/subgraph": "^2.15.1",
    "@as-integrations/express5": "^1.1.2",
    "@ecommerce/service-kit": "^0.1.0",
    "@maxmind/geoip2-node": "^7.1.0",
    "argon2": "^0.45.1",
    "dataloader": "^2.2.3",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.7",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^11.2.1",
    "ua-parser-js": "^1.0.41",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.5",
    "@graphql-codegen/typescript": "^6.1.1",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@jest/globals": "30",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ua-parser-js": "^0.7.39",
    "drizzle-kit": "^0.31.11",
    "jest": "30",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "resolutions": {
    "@ecommerce/service-kit": "portal:../../packages/service-kit"
  }
}
