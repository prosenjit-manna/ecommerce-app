# Copy to .env (git-ignored). `podman compose` reads it automatically from the repo root.

# LocalStack (SNS/SQS/S3 emulator) needs an auth token. Free Hobby plan:
# sign up at https://app.localstack.cloud → Settings → Auth Tokens → copy your personal token.
LOCALSTACK_AUTH_TOKEN=

# Optional overrides (defaults shown)
# POSTGRES_USER=ecommerce
# POSTGRES_PASSWORD=ecommerce
# POSTGRES_DB=ecommerce
# AWS_REGION=us-east-1
