{
  "name": "@ecommerce/service-kit",
  "version": "0.1.0",
  "description": "Shared server code for the ecommerce-app services: Prometheus metrics (HTTP, GraphQL outcomes, Node.js runtime)",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "default": "./dist/metrics/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "yarn build"
  },
  "peerDependencies": {
    "@apollo/server": "^5.0.0",
    "express": "^5.0.0",
    "graphql": "^16.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "dependencies": {
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "typescript": "^7.0.2"
  }
}
